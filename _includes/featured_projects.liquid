<div class="featured-project-list">
  {% assign featured_projects = site.projects | where: 'featured', true | sort: 'importance' %}
  {% for project in featured_projects %}
    <article class="featured-project-row">
      {% if project.img %}
        <a class="featured-project-media" href="{{ project.url | relative_url }}" aria-label="Read {{ project.title }} project page">
          <img src="{{ project.img | relative_url }}" alt="{{ project.title }} teaser" loading="lazy">
        </a>
      {% endif %}
      <div class="featured-project-copy">
        {% if project.status %}
          <p class="project-status">{{ project.status }}</p>
        {% endif %}
        <h3>
          <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
        </h3>
        <p>{{ project.description }}</p>
        <a class="project-read-more" href="{{ project.url | relative_url }}">Project details →</a>
      </div>
    </article>
  {% endfor %}
</div>
